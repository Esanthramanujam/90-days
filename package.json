{
  "name": "reforge-90",
  "version": "1.0.0",
  "private": true,
  "description": "Reforge 90 — a science-based 90-day transformation tracker",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
